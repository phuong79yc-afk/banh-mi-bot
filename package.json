{
  "name": "virus-scanner-bot",
  "version": "1.0.0",
  "description": "A Discord bot built with discord.js v14 and TypeScript",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/deploy-commands.js && node dist/src/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "deploy": "ts-node src/deploy-commands.ts"
  },
  "keywords": [
    "discord",
    "discordjs",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@types/express": "^5.0.6",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
