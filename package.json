{
  "name": "banh-cuon-bot",
  "version": "1.0.1",
  "description": "A Discord bot built with discord.js v14 and TypeScript",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.cpSync('assets', 'dist/assets', {recursive: true}); fs.cpSync('public', 'dist/public', {recursive: true}); fs.mkdirSync('dist/data', {recursive: true});\"",
    "start": "node --expose-gc dist/src/index.js",
    "start:old": "node --expose-gc dist/src/index.js",
    "start:deploy": "node --expose-gc dist/src/deploy-commands.js && node --expose-gc dist/src/index.js",
    "dev": "npm run build && nodemon --watch src --ext ts --exec \"npm run build && npm start\"",
    "dev:old": "nodemon --exec \"node --expose-gc -r ts-node/register src/index.ts\"",
    "deploy": "ts-node src/deploy-commands.ts",
    "push": "powershell -ExecutionPolicy Bypass -File scripts/quick-push.ps1",
    "push:msg": "powershell -ExecutionPolicy Bypass -File scripts/auto-git-push.ps1",
    "push:watch": "powershell -ExecutionPolicy Bypass -File scripts/auto-watch-push.ps1",
    "push:auto": "powershell -ExecutionPolicy Bypass -File scripts/auto-watch-push.ps1 -Interval 10",
    "backup": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1",
    "backup:full": "powershell -ExecutionPolicy Bypass -File scripts/backup.ps1 -BackupType full",
    "restore": "powershell -ExecutionPolicy Bypass -File scripts/restore.ps1"
  },
  "keywords": [
    "discord",
    "discordjs",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@discord-player/opus": "^7.2.0",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.9",
    "@snazzah/davey": "^0.1.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.10.0",
    "canvas": "^3.2.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "discord-player": "^7.2.0",
    "discord-player-youtubei": "^3.1.0",
    "discord.js": "14.27.0",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^178.0.0",
    "groq-sdk": "^1.6.0",
    "jsonwebtoken": "^9.0.3",
    "mcping-js": "^1.5.0",
    "mediaplex": "^1.0.0",
    "minecraft-server-util": "^5.4.4",
    "nodemailer": "^9.0.6",
    "play-dl": "^1.9.7",
    "simple-ytdl-core": "^1.1.1",
    "spotify-url-info": "^3.3.3",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.12.12",
    "nodemon": "^3.1.14",
    "puppeteer": "^25.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
