{
  "name": "virus-scanner-bot",
  "version": "1.0.0",
  "description": "A Discord bot built with discord.js v14 and TypeScript",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node start-bot.js",
    "start:simple": "node dist/src/index.js",
    "start:watch": "nodemon dist/src/index.js",
    "postinstall": "npm run build && node deploy-commands-render.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "dev:build": "tsc --watch",
    "dev:web": "concurrently \"npm run dev:build\" \"nodemon dist/src/index.js\"",
    "deploy-commands": "ts-node deploy-commands.ts",
    "web": "node dist/src/web/server.js"
  },
  "keywords": [
    "discord",
    "discordjs",
    "bot"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@discord-player/extractor": "^7.2.0",
    "@snazzah/davey": "^0.1.12",
    "axios": "^1.18.1",
    "canvas": "^3.2.3",
    "cheerio": "^1.2.0",
    "discord-player": "^7.2.0",
    "discord-voip": "^7.2.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.5",
    "ejs": "^5.0.2",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "gif-encoder-2": "^1.0.5",
    "mediaplex": "^1.0.0",
    "node-fetch": "^2.7.0",
    "play-dl": "^1.9.7",
    "sodium-native": "^5.1.0",
    "tiktok-app-api": "^1.4.1"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.12.12",
    "@types/node-fetch": "^2.6.13",
    "giflossy": "^3.0.41",
    "nodemon": "^3.1.14",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
