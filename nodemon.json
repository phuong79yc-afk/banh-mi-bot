{
  "watch": ["dist"],
  "ext": "js,json",
  "ignore": ["node_modules"],
  "exec": "node dist/src/index.js",
  "restartable": "rs",
  "env": {
    "NODE_ENV": "development"
  },
  "delay": 1000,
  "verbose": false,
  "events": {
    "restart": "echo 🔄 Bot restarted",
    "crash": "echo ⚠️ Bot crashed"
  }
}
