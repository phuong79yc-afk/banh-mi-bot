# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# Bot Settings
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# Web Server
PORT=3002
WEB_PORT=3000
SESSION_SECRET=your_random_secret_here

# OAuth Redirect (Update this with your Render URL)
REDIRECT_URI=https://your-app.onrender.com/auth/callback

# Google Gemini API (Optional)
GOOGLE_API_KEY=your_gemini_api_key_here

# ===== CUSTOM IMAGES FOR EMBEDS =====
# Daily command images (leave empty to use assets/ folder)
DAILY_THUMBNAIL=
DAILY_BANNER=

# Exchange/Convert command image
EXCHANGE_THUMBNAIL=

# Example URLs (you can use imgur, discord CDN, or any image host):
# DAILY_THUMBNAIL=https://i.imgur.com/abc123.png
# DAILY_BANNER=https://i.imgur.com/banner.gif
# EXCHANGE_THUMBNAIL=https://cdn.discordapp.com/attachments/123/456.png

# Recommended sizes:
# - DAILY_THUMBNAIL: 256x256px (square icon)
# - DAILY_BANNER: 1200x300px (wide banner)  
# - EXCHANGE_THUMBNAIL: 256x256px (square icon)
