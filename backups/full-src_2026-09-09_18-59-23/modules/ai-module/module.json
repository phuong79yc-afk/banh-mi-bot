{
  "name": "ai-module",
  "displayName": "AI Chat Module",
  "description": "Enhanced AI chat with context memory and multiple models (Groq, Gemini)",
  "version": "1.0.0",
  "author": "GlitchBucket Team",
  "enabled": true,
  "entry": "entry_point.ts",
  "dependencies": [],
  "permissions": [],
  "features": [
    "Multi-model AI (Groq Llama, Gemini)",
    "Conversation memory (10 messages)",
    "Multiple response styles",
    "Automatic key rotation",
    "Usage tracking",
    "Rate limiting"
  ],
  "commands": [
    {
      "name": "ai",
      "description": "Chat with AI with context memory",
      "options": [
        "message (required)",
        "model (7 choices)",
        "style (5 choices)",
        "clear_memory (boolean)"
      ]
    },
    {
      "name": "ai-memory",
      "description": "View/clear conversation memory",
      "subcommands": ["view", "clear"]
    },
    {
      "name": "ai-models",
      "description": "List available AI models"
    }
  ],
  "config": {
    "maxHistory": 10,
    "defaultModel": "groq:llama-3.3-70b",
    "defaultStyle": "default",
    "rateLimit": {
      "free": 50,
      "premium": 999999
    }
  }
}
